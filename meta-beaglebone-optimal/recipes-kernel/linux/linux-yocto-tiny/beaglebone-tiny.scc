# SPDX-License-Identifier: MIT
define KMETA_EXTERNAL_BSP t
define KMACHINE beaglebone
define KTYPE tiny
define KARCH arm

# Keep the tiny provider and tiny config baseline, but avoid the standard ARM
# patch stack that currently fails for the BBB bring-up path.
kconf required ktypes/tiny/yocto.cfg
kconf required ktypes/tiny/tiny.cfg
kconf hardware arch/arm/arm.cfg

# Reuse the upstream BBB hardware baseline that carries the AM335x
# UART/MMC/PMIC bring-up path, then let the local tiny fragment disable
# nonessential features.
kconf hardware bsp/beaglebone/beaglebone.cfg
