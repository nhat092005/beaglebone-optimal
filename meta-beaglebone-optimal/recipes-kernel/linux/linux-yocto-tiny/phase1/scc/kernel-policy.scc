# SPDX-License-Identifier: MIT

# Keep only the tiny branch and ARM metadata path needed to build a BBB tiny
# kernel. Broad standard feature buckets are intentionally excluded.
include ktypes/base/base.scc nocfg inherit
branch tiny

include arch/arm/arm.scc nopatch

# Keep the upstream tiny-aligned baseline until evidence proves it conflicts
# with the locked Phase 1 truth.
kconf required ktypes/tiny/yocto.cfg
