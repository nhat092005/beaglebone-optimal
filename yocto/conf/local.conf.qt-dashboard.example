# Qt dashboard product path - local developer overrides only.
# Append these lines into conf/local.conf after running:
#   source oe-init-build-env "$YOCTO_BUILD_DIR"

BSPDIR ??= "/workspace"

MACHINE    = "beaglebone-black-optimal-qt-dashboard"
DISTRO     = "optimal-qt-dashboard"

DL_DIR    ??= "/storage/shared/downloads"
SSTATE_DIR ??= "/storage/shared/sstate"

EXTRA_IMAGE_FEATURES = "debug-tweaks"
