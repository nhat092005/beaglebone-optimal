
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.gitnexus

# IDE files
.vscode/

# temporary files
tmp/

# agent scratch scripts/output (one-off helpers, never meant to be committed)
/.tmp-*
/.patch-regen-out*
/.qt-patch-regen-out*

# BitBake externalsrc build symlinks (created by bitbake when using externalsrc class)
qt-dashboard-app/oe-logs
qt-dashboard-app/oe-workdir

# devtool workspace source symlink (points into $YOCTO_BUILD_DIR/workspace/sources)
u-boot-src

# kernel-source symlink (points into tmp/work-shared/<machine>/kernel-source; devtool
# modify is broken for this recipe, see conversation notes - edited/patched manually)
linux-src

# Local Docker config
local.mk

# AI assistants files
.agents/
.codex/
.claude/
.beads/
CLAUDE.md
AGENTS.md

# User-specific files
.mnhat

# BeagleBone optimal build files
qt-dashboard-app/build/**
