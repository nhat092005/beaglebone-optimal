# A/B rootfs plus data partition; rootfs slots include baseline headroom.
part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4 --fixed-size 32 --sourceparams="loader=u-boot" --use-uuid
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs_a --align 4 --fixed-size 256 --use-uuid
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs_b --align 4 --fixed-size 256 --use-uuid
part /data --ondisk mmcblk0 --fstype=ext4 --label data --align 4 --fixed-size 64 --use-uuid
bootloader --configfile="beaglebone-qt-dashboard-extlinux.conf"
