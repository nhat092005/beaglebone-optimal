# /etc/inittab — BeagleBone Optimal Qt dashboard
# BusyBox init, minimal single-app kiosk

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -t sysfs sysfs /sys
::sysinit:/bin/hostname qt-dashboard
::sysinit:/sbin/rtcsync

ttyS0::respawn:/usr/bin/env HOME=/home/root /bin/sh -l
::respawn:/usr/bin/qt-dashboard.sh

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/hwclock -w
::shutdown:/bin/umount -a -r
